# Copy to .env. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required: a random private token with at least 32 characters. No default token.
NAS_TODO_TOKEN=
NAS_TODO_PORT=8787
# Optional: bind a specific NAS LAN/VPN address instead of all interfaces.
NAS_TODO_BIND_IP=0.0.0.0
# Precreate this directory and grant UID/GID 1000 write access before starting.
NAS_TODO_DATA_DIR=./data
