<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_card_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_task_priority" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:paddingLeft="7dp" android:paddingRight="7dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textSize="11sp" android:maxLines="1" android:background="@drawable/widget_priority_normal" android:textColor="#1E5EA8"/>
        <TextView android:id="@+id/widget_task_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="end" android:textSize="11sp" android:textColor="#547565" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_task_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:textSize="17sp" android:textStyle="bold" android:textColor="#244C3E" android:maxLines="3" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_check" android:layout_width="44dp" android:layout_height="36dp" android:layout_gravity="end"
        android:gravity="center" android:textSize="25sp" android:textColor="#326B58" android:contentDescription="勾选待办，打开应用保存"/>
</LinearLayout>
