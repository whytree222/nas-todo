<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_card_background">
    <TextView android:id="@+id/widget_task_date" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="11sp" android:textColor="#547565" android:maxLines="1" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_task_title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:gravity="center_vertical" android:textSize="17sp" android:textStyle="bold" android:textColor="#244C3E" android:maxLines="3" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_check" android:layout_width="44dp" android:layout_height="36dp" android:layout_gravity="end"
        android:gravity="center" android:textSize="25sp" android:textColor="#326B58" android:contentDescription="勾选待办，打开应用保存"/>
</LinearLayout>
