<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
    <TextView android:id="@+id/widget_check" android:layout_width="36dp" android:layout_height="44dp"
        android:gravity="center" android:textSize="24sp" android:textColor="#326B58" android:contentDescription="勾选待办，打开应用保存"/>
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/widget_task_title" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="13sp" android:textColor="#244C3E" android:maxLines="2" android:ellipsize="end"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:layout_marginTop="3dp">
            <TextView android:id="@+id/widget_task_priority" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingLeft="6dp" android:paddingRight="6dp" android:paddingTop="2dp" android:paddingBottom="2dp"
                android:textSize="10sp" android:maxLines="1" android:background="@drawable/widget_priority_normal" android:textColor="#1E5EA8"/>
            <TextView android:id="@+id/widget_task_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:layout_marginStart="7dp" android:textSize="10sp" android:textColor="#547565" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
